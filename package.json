{
  "name": "galatext-api",
  "version": "1.3.0",
  "description": "Official Galatext JavaScript SDK for SMS, campaigns, USSD, airtime, WhatsApp, and account services",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/galatext.esm.js",
      "require": "./dist/galatext.cjs"
    }
  },
  "main": "dist/galatext.cjs",
  "module": "dist/galatext.esm.js",
  "browser": "dist/galatext.umd.js",
  "unpkg": "dist/galatext.umd.js",
  "jsdelivr": "dist/galatext.umd.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "galatext",
    "sms",
    "bulk-sms",
    "messaging",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/galatexsoftware/galatext-api-js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
